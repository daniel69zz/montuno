# Copia a apps/api/.env (o exporta en tu shell). NO coloques secretos reales ni claves privadas aquí.
NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/montuno?schema=public
# Reservado para migrar los jobs a BullMQ; hoy los workers corren en proceso con lock de Postgres.
REDIS_URL=redis://localhost:6379
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
SESSION_TTL_SECONDS=3600
FRONTEND_ORIGIN=http://localhost:3001
PUBLIC_CHECKOUT_BASE_URL=http://localhost:3001/checkout
PUBLIC_API_BASE_URL=http://localhost:3000
AUTH_DOMAIN=localhost
AUTH_THROTTLE_LIMIT=10

# --- Stellar: SOLO testnet (la validación rechaza cualquier otra red) ---
STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# soroban = contrato real en Testnet | simulated = ledger en memoria (dev/tests, marcado SIMULATED)
ESCROW_GATEWAY=simulated
# Despliegue registrado en docs/deployments/testnet.json (token = USDC de Circle de TESTNET):
STELLAR_ESCROW_CONTRACT_ID=CA3CWIHORCCANE73NITO5T2I652SGR4SOUZDMHXVQUH5T4DGX7YJQCTR
STELLAR_ESCROW_TOKEN_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
STELLAR_ARBITER_ADDRESS=GDTV2M5CAZ4E5AIXDHQARM7UUPJ4KGJVPXLU5S2D3ZVPTMETNXW6ACKQ
STELLAR_TOKEN_DECIMALS=7
STELLAR_MAX_ADVANCE_BPS=9000
STELLAR_EXPLORER_BASE_URL=https://stellar.expert/explorer/testnet
STELLAR_TX_TIMEOUT_SECONDS=300

# --- Pollar / proveedores: solo "mock" está implementado (ver docs/pollar-integration.md) ---
IDENTITY_PROVIDER=mock
POLLAR_MODE=mock
POLLAR_KYC_MODE=mock
POLLAR_RAMP_MODE=mock
# Llave PÚBLICA de Pollar (pub_testnet_... / pk_..., dashboard.pollar.xyz). Esta es la de la app de Montuno en testnet;
# solo funciona desde los orígenes autorizados en Pollar (Build → Domains → Allowed origins). La usa el navegador para el login con correo;
# /api/v1/config la expone. Vacía = no se ofrece Pollar. No hay secreto de servidor documentado.
POLLAR_API_KEY=pub_testnet_60cbf22a82a66c86774604ce88cf38ad
POLLAR_BASE_URL=
# Rampa: mock (no mueve tokens) | caja-testnet (pago BOB SIMULADO + USDC de Circle de TESTNET real desde una caja).
# caja-testnet exige ESCROW_GATEWAY=soroban, está prohibida en production y es la única clave del servidor:
# solo firma transferencias DESDE la caja. Obtén la clave con: stellar keys secret ie-caja
RAMP_PROVIDER=mock
RAMP_CAJA_SECRET=
RAMP_CAJA_MAX_PER_ORDER_ATOMIC=5000000000
MOCK_KYC_AUTO_APPROVE=true
MOCK_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_DEV_SECRET

OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_BUCKET=montuno-dev
OBJECT_STORAGE_LOCAL_DIR=./storage
EVIDENCE_MAX_BYTES=10485760

ADMIN_INITIAL_EMAIL=admin@example.local
JOBS_ENABLED=true
JOBS_INDEXER_INTERVAL_MS=15000
JOBS_RECONCILE_INTERVAL_MS=60000
LOG_LEVEL=info
