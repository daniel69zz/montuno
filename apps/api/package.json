{
  "name": "@montuno/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPattern=src/",
    "test:integration": "jest --runInBand --testPathPattern=test/",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "e2e:testnet": "ts-node scripts/e2e-testnet.ts"
  },
  "dependencies": {
    "@montuno/shared": "0.1.0",
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.11",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.8.0",
    "@prisma/client": "6.19.3",
    "@stellar/stellar-sdk": "17.4.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.11",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testRegex": ".*\\.(spec|e2e-spec)\\.ts$",
    "testTimeout": 30000,
    "setupFiles": [
      "<rootDir>/test/env.setup.ts"
    ],
    "globalSetup": "<rootDir>/test/global-setup.ts",
    "transform": {
      "^.+\\.[tj]s$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true,
            "esModuleInterop": true,
            "experimentalDecorators": true,
            "emitDecoratorMetadata": true,
            "strict": true,
            "strictPropertyInitialization": false,
            "skipLibCheck": true,
            "target": "ES2022",
            "module": "commonjs",
            "types": [
              "node",
              "jest"
            ]
          },
          "diagnostics": {
            "ignoreCodes": [
              "TS151001"
            ]
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(uint8array-extras|@exodus/bytes|@noble/ed25519|@noble/hashes|axios|proxy-from-env|eventsource|eventsource-parser|is-retry-allowed|smol-toml)/)"
    ]
  },
  "license": "MIT"
}
